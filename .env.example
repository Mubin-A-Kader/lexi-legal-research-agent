# Copy to .env and fill in. Required (default provider = OpenAI).
OPENAI_API_KEY=sk-...

# Shared access key gating the Streamlit UI. Unset = app open. Set the SAME value in Render.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
APP_PASSWORD=

# Optional overrides (defaults shown)
# EMBED_MODEL=text-embedding-3-small   # OpenAI embeddings (no in-process model → fits 512 MB)
# ENABLE_RERANKER=true                 # bi-encoder cosine rerank via OpenAI embeds
# LLM_PROVIDER=openai            # or "anthropic"
# AGENT_MODEL=gpt-4o-mini        # cheapest OpenAI w/ reliable tool-calling
# EVAL_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=               # set to https://api.deepseek.com to reuse via DeepSeek
# CORPUS_DIR=/absolute/path/to/lexi_research_take_home_assessment_docs

# If LLM_PROVIDER=anthropic instead:
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-sonnet-4-6
# EVAL_MODEL=claude-haiku-4-5
